{
  "schema_version": 1,
  "bundle_id": "company-ai-poc-diagnostics",
  "bundle_version": "1.0.0",
  "mission": {
    "mission_id": "diagnostic-investigation",
    "objective": "Investigate one diagnostic event for a configured service alias. Collect its diagnostic snapshot through the approved operation and write a local report that separates observations, hypotheses, and missing information."
  },
  "workflow": {
    "workflow_id": "diagnostic-investigation",
    "skill_id": "diagnostic-investigation",
    "required_operation": "diagnostics.read",
    "report_required": true
  },
  "skill": {
    "skill_id": "diagnostic-investigation",
    "path": "skills/diagnostic-investigation.md",
    "sha256": "7ac34d86bf7518f2246621904433e6c7bccc489a1573d4be00bf84cf6714a334"
  },
  "operations": {
    "diagnostics.read": {
      "description": "Read the diagnostic JSON document for one configured resource alias.",
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_alias"],
        "properties": {
          "resource_alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    }
  },
  "policy": {
    "policy_version": "2026.11.25.1",
    "identities": {
      "investigator": {
        "allow": [
          {"operation": "diagnostics.read", "resources": ["demo-service-a"]}
        ]
      },
      "auditor": {
        "allow": [
          {"operation": "diagnostics.read", "resources": ["demo-service-a", "demo-service-b"]}
        ]
      }
    },
    "limits": {
      "max_result_bytes": 8192,
      "max_model_turns": 6,
      "max_tool_proposals": 4,
      "max_provider_attempts": 4,
      "max_duration_seconds": 30,
      "request_timeout_seconds": 5,
      "max_input_bytes": 65536,
      "max_transient_retries": 1,
      "max_output_tokens": 512
    }
  },
  "resources": {
    "demo-service-a": {
      "fixture": {"path": "service-a.json", "behavior": "read"},
      "s3": {"bucket": "YOUR_BUCKET", "key": "diagnostics/demo-service-a.json"}
    },
    "demo-service-b": {
      "fixture": {"path": "service-b.json", "behavior": "read"},
      "s3": {"bucket": "YOUR_BUCKET", "key": "diagnostics/demo-service-b.json"}
    },
    "demo-hostile": {
      "fixture": {"path": "hostile.json", "behavior": "read"},
      "s3": {"bucket": "YOUR_BUCKET", "key": "diagnostics/demo-hostile.json"}
    },
    "demo-malformed": {
      "fixture": {"path": "malformed.txt", "behavior": "read"},
      "s3": {"bucket": "YOUR_BUCKET", "key": "diagnostics/demo-malformed.json"}
    },
    "demo-oversized": {
      "fixture": {"path": "oversized.json", "behavior": "read"},
      "s3": {"bucket": "YOUR_BUCKET", "key": "diagnostics/demo-oversized.json"}
    },
    "demo-timeout": {
      "fixture": {"path": "timeout.txt", "behavior": "timeout"},
      "s3": {"bucket": "YOUR_BUCKET", "key": "diagnostics/demo-timeout.json"}
    },
    "demo-unavailable": {
      "fixture": {"path": "unavailable.txt", "behavior": "unavailable"},
      "s3": {"bucket": "YOUR_BUCKET", "key": "diagnostics/demo-unavailable.json"}
    }
  },
